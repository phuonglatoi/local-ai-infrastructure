###############################################################################
# LOCAL AI INFRASTRUCTURE - Environment Variables
# Copy this file to .env and fill in the values
#
#   cp .env.example .env
#   # Then edit .env with your values
###############################################################################

############
# General
############
COMPOSE_PROJECT_NAME=local-ai

############
# N8N Configuration
############
N8N_ENCRYPTION_KEY=your-n8n-encryption-key-here
N8N_USER_MANAGEMENT_JWT_SECRET=your-n8n-jwt-secret-here
N8N_PORT=5678

############
# Supabase / PostgreSQL
############
POSTGRES_PASSWORD=your-strong-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_SECRET=your-supabase-jwt-secret-min-32-chars
JWT_EXP=3600
ANON_KEY=your-supabase-anon-key
SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PUBLIC_URL=http://localhost:8000

############
# Open WebUI
############
WEBUI_PORT=8080
WEBUI_SECRET_KEY=your-webui-secret-key

############
# SearXNG
############
SEARXNG_PORT=8888

############
# Caddy / Domain Configuration (Production only)
# Uncomment and configure when deploying with --environment public
############
# N8N_HOSTNAME=n8n.yourdomain.com
# WEBUI_HOSTNAME=ai.yourdomain.com
# SUPABASE_HOSTNAME=supabase.yourdomain.com
# SEARXNG_HOSTNAME=search.yourdomain.com
# LETSENCRYPT_EMAIL=your-email@example.com

############
# Kong (Supabase API Gateway)
############
KONG_HTTP_PORT=8000
